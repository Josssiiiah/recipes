{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "bun install --cwd backend --frozen-lockfile",
    "watchPatterns": [
      "/backend/**",
      "/railway.json"
    ]
  },
  "deploy": {
    "startCommand": "bun --cwd backend start"
  }
}
